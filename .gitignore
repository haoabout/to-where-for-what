.DS_Store
__pycache__/
*.pyc
.venv/
node_modules/

# Trips are the user's own data, not part of the skill: real dates, real
# lodging, real choices. Nothing in the skill or its docs reads this directory
# — the 2026-09-osaka paths in README.md and SKILL.md are illustrative — so it
# has no business in a public repo. Ignored wholesale rather than per-file so
# a new trip can't arrive already staged.
trips/

# Impeccable's per-project config. Its detector suppressions are decisions
# about this repo's UI code, which is only useful to someone running the
# detector here — and the people cloning this are installing a travel-planning
# skill, not developing its interface. The local copy stays on disk and keeps
# working; it just isn't anyone else's business.
# Its cache/pending/config.local siblings were already excluded by impeccable's
# own hook installer, but that lives in .git/info/exclude, which does not
# survive a clone — so the whole directory is named here instead.
.impeccable/

# Development-time scratch files
.tmp/
